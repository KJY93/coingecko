# MongoDB
APP_MONGODB_URL=mongodb://127.0.0.1:27018
APP_MONGODB_DB_NAME=gecko

# Redis
APP_REDIS_URL=redis://127.0.0.1:6380

# CoinGecko API
APP_COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
APP_COINGECKO_APIKEY=your_coingecko_api_key_here

# Scheduler & cache
APP_SCHEDULER_INTERVAL_SECONDS=300
APP_CACHE_TTL_SECONDS=300
APP_COINS_REFRESH_HOURS=24

# JWT auth
APP_JWT_SECRET_KEY=generate_with_python_secrets_token_hex_32
APP_JWT_ALGORITHM=HS256
APP_JWT_EXPIRE_MINUTES=60

# RabbitMQ
APP_RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Locust
APP_RATE_LIMIT_ENABLED=true    # set false to disable rate limiting (for load testing)